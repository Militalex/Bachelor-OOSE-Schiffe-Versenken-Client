<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.gitlab.kaisoenmalex.windows.WaitController">
   <HBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
         <HBox.margin>
            <Insets />
         </HBox.margin>
         <Label fx:id="lbl_wait" alignment="CENTER" prefHeight="20.0" prefWidth="200.0">
            <VBox.margin>
               <Insets top="50.0" />
            </VBox.margin>
            <font>
               <Font size="20.0" />
            </font>
         </Label>
         <TextField fx:id="lbl_code" alignment="CENTER" editable="false" prefHeight="25.0" prefWidth="457.0" visible="false">
            <VBox.margin>
               <Insets bottom="10.0" left="150.0" right="150.0" />
            </VBox.margin>
         </TextField>
         <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
            <VBox.margin>
               <Insets bottom="20.0" />
            </VBox.margin>
            <Image url="@../styles/animation/laden.gif" />
         </ImageView>
         <Button fx:id="btn_quit" mnemonicParsing="false" prefHeight="33.0" prefWidth="89.0" onAction="#onClickQuit" text="Beenden" />
      </VBox>
   </HBox>
</AnchorPane>
