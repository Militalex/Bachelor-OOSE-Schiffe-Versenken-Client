<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="de.gitlab.kaisoenmalex.windows.EndController">
   <HBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <VBox alignment="TOP_CENTER" prefHeight="400.0" prefWidth="600.0">
         <Label fx:id="lbl_result" alignment="CENTER">
            <VBox.margin>
               <Insets top="50.0" />
            </VBox.margin>
            <font>
               <Font size="29.0" />
            </font>
         </Label>
         <Label fx:id="lbl_surrender" alignment="CENTER" text="Der Gegner hat aufgegeben" textFill="#e41010">
            <VBox.margin>
               <Insets top="30.0" />
            </VBox.margin>
            <font>
               <Font size="20.0" />
            </font>
         </Label>
         <Button mnemonicParsing="false" onAction="#onCLickMenu" prefHeight="40.0" text="Zurück zum Menü">
            <VBox.margin>
               <Insets top="50.0" />
            </VBox.margin>
         </Button>
         <Button mnemonicParsing="false" onAction="#onQuit" text="Beenden">
            <VBox.margin>
               <Insets top="30.0" />
            </VBox.margin>
         </Button>
      </VBox>
   </HBox>
   <Button fx:id="btn_mute" mnemonicParsing="false" text="Button" />
</AnchorPane>
